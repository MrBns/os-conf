// ---------------------------------------------------------------------------
// Equivalent of index.sh - the entry point.
//
// index.sh is sourced by .zshrc and sources the rest in turn. An Amber program
// cannot be sourced (it compiles to a script that runs in its own process, and
// the zsh target opens with `emulate ksh`, which would wreck an interactive
// shell), so this prints the zsh it wants installed and .zshrc evaluates it:
//
//     eval "$(~/.config/os-conf/extra/amber-impl/build/index)"
//
// Order matches index.sh: path, service, alias, options, then the mode module,
// then the machine-local overrides last so they can override anything the
// shared modules set.
// ---------------------------------------------------------------------------

import { file_exists } from "std/fs"
import { emit_section, emit_comment, emit_export, emit_func_line, emit_line } from "./lib/emit.ab"
import { env_or, os_id, os_like } from "./lib/platform.ab"
import { oc_mode, MODE_SERVER } from "./lib/mode.ab"
import { emit_path } from "./conf/path.ab"
import { emit_service } from "./conf/service.ab"
import { emit_aliases } from "./conf/alias.ab"
import { emit_options } from "./conf/options.ab"
import { emit_desktop } from "./conf/mode/desktop.ab"
import { emit_server } from "./conf/mode/server.ab"

fun emit_header(oc_base: Text, oc_src: Text, amber_bin: Text, mode: Text): Null {
    emit_comment("Generated by extra/amber-impl/index.ab - do not edit, edit the .ab sources.")
    emit_comment("Rebuild and reload with `oc-regen`.")

    emit_section("Base")
    emit_comment("OC_BASE - the repo root, holds the entrypoint and your untracked local overrides.")
    emit_comment("OC_SRC  - the tracked config itself.")
    emit_export("OC_BASE", oc_base)
    emit_export("OC_SRC", oc_src)
    emit_comment("Where the compiled Amber programs live; the wrappers below use it.")
    emit_export("OC_AMBER_BIN", amber_bin)

    emit_line("")
    emit_comment("Distro detection, resolved by Amber from /etc/os-release.")
    emit_comment("OS_ID   - exact distro id   (cachyos, fedora, ubuntu, ...)")
    emit_comment("OS_LIKE - the family it derives from (arch, debian, ...) - may hold several.")
    emit_comment("Pre-set OS_ID in the environment to force a platform.")
    emit_export("OS_ID", os_id())
    emit_export("OS_LIKE", os_like())

    emit_line("")
    emit_comment("Machine role, resolved by Amber from OC_MODE (default: desktop).")
    emit_comment("desktop - the full setup: themed prompt, GUI editors, clipboard, VPN.")
    emit_comment("server  - the trimmed setup for a VPS: plain prompt, none of the GUI bits.")
    emit_export("OC_MODE", mode)
    emit_comment("Kept so anything downstream can still branch on the role.")
    emit_func_line("oc_is_desktop", "[ \"$OC_MODE\" = desktop ]")
    emit_func_line("oc_is_server", "[ \"$OC_MODE\" = server ]")
}

/// Machine-local overrides, last of all. This repo is public, so email
/// addresses, client paths and anything else identifying live here.
///
/// Both flavours are honoured: the compiled Amber module (local.ab, built to
/// build/bin/local) and the plain-zsh local.sh. Both are gitignored and absent
/// on a fresh clone, in which case nothing is emitted for them.
fun emit_local_overrides(oc_base: Text, amber_bin: Text): Null {
    const amber_local = "{amber_bin}/local"
    const shell_local = "{oc_base}/local.sh"

    const has_amber = file_exists(amber_local)
    const has_shell = file_exists(shell_local)

    emit_section("Machine-local overrides")

    if has_amber {
        emit_line("eval \"$(\"{amber_local}\")\"")
    }
    if has_shell {
        emit_line("source \"{shell_local}\"")
    }
    if not has_amber and not has_shell {
        emit_comment("None found - see extra/amber-impl/local.example.ab.")
    }
}

main {
    const home = env_or("HOME", "/root")
    const oc_base = env_or("OC_BASE", "{home}/.config/os-conf")
    const oc_src = env_or("OC_SRC", "{oc_base}/src")
    const amber_root = "{oc_base}/extra/amber-impl"
    const amber_bin = env_or("OC_AMBER_BIN", "{amber_root}/build/bin")
    const mode = oc_mode()

    emit_header(oc_base, oc_src, amber_bin, mode)
    emit_path(home, oc_src, mode)
    emit_service(home)
    emit_aliases()
    emit_options()

    // Mode module next, so it can override anything the shared modules set.
    if mode == MODE_SERVER {
        emit_server()
    } else {
        emit_desktop()
    }

    emit_local_overrides(oc_base, amber_bin)

    emit_section("Convenience")
    emit_comment("Rebuild the Amber sources and reload this shell's config.")
    emit_line("oc-regen() \{ \"{amber_root}/build.sh\" && eval \"$(\"{amber_bin}/index\")\"; }")
}
